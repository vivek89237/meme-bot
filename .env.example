# Hugging Face model identifiers and inference access
HF_TOKEN=
HF_MODEL=
HF_IMAGE_MODEL=

# Instagram publishing
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0

# Supabase project and Storage bucket
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the secret key (sb_secret_...) or legacy service_role JWT.
# The publishable key (sb_publishable_...) is blocked by Storage RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=Meme
