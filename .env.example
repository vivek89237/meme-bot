# Hugging Face model identifiers and inference access
HF_TOKEN=
HF_MODEL=
# Quality profile tuned for FLUX.1-dev; model/provider access must be enabled.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_STEPS=28
HF_IMAGE_GUIDANCE=3.5
# Optional seed for reproducible artwork. Retries increment it once.
HF_IMAGE_SEED=

# Required for the agent's visual quality gate: choose a vision-capable chat model
# available on your explicit provider. HF_MODEL may be text-only.
HF_VISION_MODEL=
HF_VISION_PROVIDER=

# Caption panel palette: light or dark
MEME_TEMPLATE=light

# Instagram publishing
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0

# Supabase project and Storage bucket
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the secret key (sb_secret_...) or legacy service_role JWT.
# The publishable key (sb_publishable_...) is blocked by Storage RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=Meme

# Character consistency: opt in after adding your approved images.
HF_IMAGE_MODE=text
HF_REFERENCE_MODEL=black-forest-labs/FLUX.1-Kontext-dev
# With mode=reference, list 1–4 actual local PNG/JPEG/WebP paths as JSON:
# HF_CHARACTER_REFERENCES=["assets/characters/reference-sheet.png"]
HF_CHARACTER_REFERENCES=

# Optional override of the default artwork style instructions (scene is appended).
# Blank/unset retains the built-in style. Reference identity instructions still apply.
HF_ARTWORK_PROMPT="Create a new scene using the reference only for character identity. Replace its poses and background with the requested scene. Preserve faces, fur colors and markings. Make all requested props clearly visible. Use clean flat 2D illustration with solid pastel colors. No text, letters, logos or watermarks."
