# Hugging Face model identifiers and inference access
HF_TOKEN=
HF_MODEL=
# Quality profile tuned for FLUX.1-dev; model/provider access must be enabled.
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev
HF_IMAGE_PROVIDER=fal-ai
HF_IMAGE_STEPS=28
HF_IMAGE_GUIDANCE=3.5
# Optional seed for reproducible artwork. Retries increment it once.
HF_IMAGE_SEED=

# Required for the agent's visual quality gate: choose a vision-capable chat model
# available on your explicit provider. HF_MODEL may be text-only.
HF_VISION_MODEL=
HF_VISION_PROVIDER=

# Caption panel palette: light or dark
MEME_TEMPLATE=light

# Instagram publishing
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
GRAPH_API_VERSION=v24.0

# Supabase project and Storage bucket
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be the secret key (sb_secret_...) or legacy service_role JWT.
# The publishable key (sb_publishable_...) is blocked by Storage RLS.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=Meme
